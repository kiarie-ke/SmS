# ---------------------------------------------------------------------------
# Copy to apps/api/.env (API + Prisma) and apps/web/.env.local (web subset).
# Run: docker compose up -d db
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://school:school@localhost:5435/school_system?schema=public

# Auth
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false

# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
SESSION_SECRET=replace-with-at-least-32-random-characters

# M-Pesa / Safaricom Daraja (Phase 5)
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=

# Africa's Talking SMS (Phase 5)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Cloudinary (Phase 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
