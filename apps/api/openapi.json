  "info": {
    "title": "School System API",
    "description": "School management API for Kenyan primary, JSS and secondary schools. Grading supports CBC performance levels and 8-4-4 numeric bands. Currency is KES; all date logic uses Africa/Nairobi.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ss_refresh"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "clerk@mwangaza.ac.ke"
          },
          "phone": {
            "type": "string",
            "example": "+254712345678"
          },
          "password": {
            "type": "string",
            "example": "Str0ngPassw0rd",
            "minLength": 8
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "TEACHER",
              "STUDENT",
              "PARENT"
            ],
            "example": "TEACHER"
          }
        },
        "required": [
          "email",
          "phone",
          "password",
          "role"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "example": "admin@mwangaza.ac.ke"
          },
          "phone": {
            "type": "string",
            "example": "+254720123457"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "TEACHER",
              "STUDENT",
              "PARENT"
            ],
            "example": "ADMIN"
          },
          "isActive": {
            "type": "boolean"
          },
          "lastLoginAt": {
            "type": "string",
            "nullable": true,
            "example": null
          }
        },
        "required": [
          "id",
          "email",
          "phone",
          "role",
          "isActive",
          "lastLoginAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@mwangaza.ac.ke"
          },
          "password": {
            "type": "string",
            "example": "Admin@1234"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived bearer token (keep in memory only)"
          },
          "expiresIn": {
            "type": "number",
            "description": "Access token lifetime in seconds",
            "example": 900
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "MessageResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Logged out"
          }
        },
        "required": [
          "message"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@mwangaza.ac.ke"
          }
        },
        "required": [
          "email"
        ]
      },
      "ForgotPasswordResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "resetToken": {
            "type": "string",
            "description": "Only returned outside production so the reset flow can be tested"
          }
        },
        "required": [
          "message"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "TEACHER",
              "STUDENT",
              "PARENT"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "phone",
          "role"
        ]
      },
      "CsrfInfoResponseDto": {
        "type": "object",
        "properties": {
          "cookieName": {
            "type": "string",
            "example": "ss_csrf"
          },
          "headerName": {
            "type": "string",
            "example": "x-csrf-token"
          }
        },
        "required": [
          "cookieName",
          "headerName"
        ]
      }
    }
  }
}
